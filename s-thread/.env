# S-Thread Frontend Environment Variables
# Replace these placeholders with your actual developer portal client credentials:

# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Facebook App ID (from Meta for Developers Portal)
VITE_FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID

# Apple Service ID / Client ID (from Apple Developer Console)
VITE_APPLE_CLIENT_ID=YOUR_APPLE_CLIENT_ID
